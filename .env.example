# Home Assistant — long-lived token from your HA profile → Security. Stays on the server.
HOME_ASSISTANT_URL=https://hass.example.com
HOME_ASSISTANT_TOKEN=

# First-run defaults only; after that edit data/denboard.json
DASHBOARD_LAT=39.7392
DASHBOARD_LON=-104.9903
DASHBOARD_TZ=America/Denver
WEATHER_UNITS=imperial
# GCAL_ICS_URL=   (optional single calendar; add more in data/denboard.json)

PORT=3000
# DENBOARD_FRAME_ANCESTORS='self' https://hass.example.com
# DENBOARD_DEMO=1   (sample calendar + house data for previewing layouts)
